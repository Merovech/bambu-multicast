{
  "name": "bambu-multicast-tests",
  "private": true,
  "description": "Dev-only test tooling. Nothing here is needed to run the site.",
  "scripts": {
    "test": "jest",
    "test:perf": "jest --testPathIgnorePatterns=/node_modules/ --testPathPatterns=perf",
    "build:css": "tailwindcss -c tailwind.config.js -i tailwind.input.css -o client/tailwind.css --minify"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "roots": [
      "<rootDir>/tests/client"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "perf\\.test\\.js$"
    ]
  },
  "devDependencies": {
    "github-markdown-css": "5.9.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "tailwindcss": "^3.4.17"
  }
}
